{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "trendLine",
  "position": {
    "x": 40,
    "y": 270,
    "z": 11,
    "height": 400,
    "width": 880,
    "tabOrder": 11
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Date"
                    }
                  },
                  "Property": "Month Start"
                }
              },
              "queryRef": "Date.Month Start",
              "nativeQueryRef": "Month Start",
              "active": true,
              "displayName": "Month"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Complaints"
                }
              },
              "queryRef": "_Measures.Complaints",
              "nativeQueryRef": "Complaints",
              "displayName": "This year"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "Complaints PY"
                }
              },
              "queryRef": "_Measures.Complaints PY",
              "nativeQueryRef": "Complaints PY",
              "displayName": "Same period last year"
            }
          ]
        }
      }
    },
    "objects": {
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1F3864'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Complaints"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#9AA7BD'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.Complaints PY"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Monthly complaints vs. last year'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#1F3864'"
                    }
                  }
                }
              }
            },
            "bold": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "14D"
                }
              }
            }
          }
        }
      ],
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Complete months only. Grey line = same month one year earlier.'"
                }
              }
            },
            "fontColor": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#5B6472'"
                    }
                  }
                }
              }
            }
          }
        }
      ]
    }
  },
  "filterConfig": {
    "filters": [
      {
        "name": "fltTrendComplete",
        "field": {
          "Measure": {
            "Expression": {
              "SourceRef": {
                "Entity": "_Measures"
              }
            },
            "Property": "Is Complete Month"
          }
        },
        "type": "Advanced",
        "filter": {
          "Version": 2,
          "From": [
            {
              "Name": "m",
              "Entity": "_Measures",
              "Type": 0
            }
          ],
          "Where": [
            {
              "Condition": {
                "Comparison": {
                  "ComparisonKind": 0,
                  "Left": {
                    "Measure": {
                      "Expression": {
                        "SourceRef": {
                          "Source": "m"
                        }
                      },
                      "Property": "Is Complete Month"
                    }
                  },
                  "Right": {
                    "Literal": {
                      "Value": "1L"
                    }
                  }
                }
              }
            }
          ]
        },
        "howCreated": "User"
      }
    ]
  }
}